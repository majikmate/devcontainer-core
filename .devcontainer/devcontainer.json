// devcontainer-core: the base of all Dev Container images.
// The layers declare their own settings (user, terminal, lifecycle commands);
// this file adds the settings that every image shares. The release workflow
// writes both into the image label devcontainer.metadata.
// Documentation: https://github.com/majikmate/devcontainer-core#readme
{
  "name": "Dev Container Core",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // Markdown preview in GitHub style: the four extensions of the pack
        // bierner.github-markdown-preview, listed one by one. The pack is not
        // used, because VS Code before 1.122 gets an older version of the pack,
        // and that version also installs bierner.markdown-yaml-preamble.
        "bierner.markdown-preview-github-styles",
        "bierner.markdown-emoji",
        "bierner.markdown-checkbox",
        "bierner.markdown-footnotes",
        // Not installed: bierner.markdown-yaml-preamble is deprecated (VS Code
        // 1.121 and later shows the front matter in the preview itself), and its
        // table of the front matter replaces the front matter of VS Code
        "-bierner.markdown-yaml-preamble"
      ],
      "settings": {
        // Open Markdown files in the preview
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        },
        // Initial color theme
        "workbench.colorTheme": "Visual Studio Dark",
        // Git in VS Code: fetch automatically, stash and rebase on sync, sync after commit
        "git.autofetch": true,
        "git.autoStash": true,
        "git.confirmSync": false,
        "git.enableSmartCommit": true,
        "git.postCommitCommand": "sync",
        "git.rebaseWhenSync": true,
        "git.rememberPostCommitCommand": false,
        "git.useEditorAsCommitInput": false,
        // A folder inside a repository, opened as the folder of VS Code (for
        // example a project in a subfolder, opened with `code .`), uses that
        // repository in Source Control without asking first
        "git.openRepositoryInParentFolders": "always"
      }
    }
  }
}
